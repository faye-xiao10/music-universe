# Copy this file to .env and fill in your Spotify app credentials.
# .env is gitignored and must never be committed.
# Create an app at https://developer.spotify.com/dashboard and register the
# redirect URI below EXACTLY (Spotify requires the literal 127.0.0.1, not localhost).

SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
